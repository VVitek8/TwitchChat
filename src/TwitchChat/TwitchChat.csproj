<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>V8.TwitchChat</AssemblyName>
    <AssemblyTitle>TwitchChat</AssemblyTitle>
    <Version>1.2.0</Version>
    <RootNamespace>PeakTextChat</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!-- ThunderPipe -->
  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>TwitchChat</ThunderstoreName>
    <ThunderstoreDescription>Integration of Twitch chat into PeakTextChat (fork)</ThunderstoreDescription>
    <ThunderstoreCommunities>peak</ThunderstoreCommunities>
    <ThunderstoreCategories>mods</ThunderstoreCategories>
  </PropertyGroup>

  <!-- Файлы для копирования в плагины (только необходимые для работы) -->
  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
    
    <!-- TwitchLib и основные зависимости -->
    <ModFile Include="..\..\libs\TwitchLib.Client.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\TwitchLib.Client.Models.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\TwitchLib.Client.Enums.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\TwitchLib.Communication.dll" Destination="plugins/" />
    
    <!-- Системные зависимости (необходимы для TwitchLib) -->
    <ModFile Include="..\..\libs\System.Memory.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\System.Buffers.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\System.Runtime.CompilerServices.Unsafe.dll" Destination="plugins/" />
    
    <!-- Зависимости логирования -->
    <ModFile Include="..\..\libs\Microsoft.Extensions.Logging.Abstractions.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\Microsoft.Extensions.DependencyInjection.Abstractions.dll" Destination="plugins/" />
    <ModFile Include="..\..\libs\System.Diagnostics.DiagnosticSource.dll" Destination="plugins/" />
  </ItemGroup>

  <!-- Явное включение файлов из корня -->
  <ItemGroup>
    <Compile Include="..\..\PeakTextChatPlugin.cs" />
    <Compile Include="..\..\MyPluginInfo.cs" />
  </ItemGroup>

  <!-- Ссылки на библиотеки игры (только для компиляции) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\libs\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\libs\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\..\libs\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>..\..\libs\PhotonUnityNetworking.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>..\..\libs\PhotonRealtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>..\..\libs\Photon3Unity3D.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\libs\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\..\libs\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\libs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>..\..\libs\UnityEngine.InputModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- PEAKLib для компиляции (не копируются в релиз, т.к. указаны как зависимости в manifest.json) -->
    <Reference Include="com.github.PEAKModding.PEAKLib.Core">
      <HintPath>..\..\libs\com.github.PEAKModding.PEAKLib.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="com.github.PEAKModding.PEAKLib.UI">
      <HintPath>..\..\libs\com.github.PEAKModding.PEAKLib.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Эти ссылки нужны только для компиляции, не копируются -->
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\libs\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>..\..\libs\Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Diagnostics.DiagnosticSource">
      <HintPath>..\..\libs\System.Diagnostics.DiagnosticSource.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Thunderstore метаданные -->
  <ItemGroup>
      <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
      <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
      <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
      <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
      <ThunderstoreDependency Include="BepInEx-BepInExPack_PEAK" Version="5.4.75301" />
      <!--
      <ThunderstoreDependency Include="PEAKModding-PEAKLib_Core" Version="1.7.0" />
      <ThunderstoreDependency Include="PEAKModding-PEAKLib_UI" Version="1.6.1" />
      -->
  </ItemGroup>

  <!-- NuGet зависимости для компиляции -->
  <ItemGroup>
    <PackageReference Include="TwitchLib.Client" Version="3.3.1" />
    <PackageReference Include="TwitchLib.Communication" Version="1.0.4" />
  </ItemGroup>
</Project>